# --- Required -------------------------------------------------------------
# Your bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# --- ffmpeg ---------------------------------------------------------------
# "ffmpeg" works if it's on your PATH. The setup script sets an absolute path
# here automatically on Windows so you don't have to restart your terminal.
FFMPEG_PATH=ffmpeg

# --- Sounds ---------------------------------------------------------------
# Folder (relative to the project) that holds the audio clips to play.
SOUNDS_DIR=sounds

# Phase 2 scaffolding: folder for future video-raid clips (not played yet).
VIDEO_CLIPS_DIR=video_clips

# --- Feature toggles ------------------------------------------------------
ENABLE_VOICE=true
ENABLE_REPLIES=true

# --- Voice raid timing (seconds) ------------------------------------------
# A random wait between these two values before each raid.
VOICE_MIN_INTERVAL=300
VOICE_MAX_INTERVAL=1800
# Playback volume, 0.0 - 2.0 (1.0 = original).
VOICE_VOLUME=0.8

# --- Random replies -------------------------------------------------------
# Chance (0.0 - 1.0) to reply to any given message.
REPLY_CHANCE=0.05
# Minimum seconds between replies in the same channel.
REPLY_COOLDOWN=60

# --- Optional -------------------------------------------------------------
# Command prefix for the helper commands (note the trailing space).
COMMAND_PREFIX=!chaos
# Restrict the bot to specific server IDs (comma-separated). Empty = all servers.
GUILD_ALLOWLIST=
